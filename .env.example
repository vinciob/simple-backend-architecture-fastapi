ENVIRONMENT=development
# Generate both values with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgresql+asyncpg://showcase:replace-with-a-random-hex-password@localhost:5432/showcase
DATABASE_POOL_SIZE=20
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
ACCESS_TOKEN_TTL=600
REFRESH_TOKEN_TTL=604800
PASSWORD_CONCURRENCY=4
